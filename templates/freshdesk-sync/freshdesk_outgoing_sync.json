      "name": "Create Ticket in Freshdesk",
      "id": "template:action:03075045-d668-4f0b-8a9f-896d1befbc3a",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if Freshdesk ticket ID exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create Freshdesk tickets for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
    },
    {
