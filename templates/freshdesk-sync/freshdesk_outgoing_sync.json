      "body": "{\n  \"fields\": {\n    \"customfield_10153\": \"{{_flow.freshdeskTicketId}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}",
