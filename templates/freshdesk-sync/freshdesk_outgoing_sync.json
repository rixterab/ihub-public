  "description": "Sync Jira issues to Freshdesk tickets",
  "enabled": false,
  "flowVariables": [
    {
      "name": "FRESHDESK_URL",
      "behavior": "SET",
      "value": "https://your-domain.freshdesk.com",
      "instruction": "Freshdesk account URL, for example https://customer.freshdesk.com"
    },
    {
      "name": "FRESHDESK_REQUESTER_EMAIL",
      "behavior": "SET",
      "value": "jira-sync@example.com",
      "instruction": "Requester email used when Jira creates Freshdesk tickets"
    },
    {
      "name": "FRESHDESK_DEFAULT_PRIORITY",
      "behavior": "SET",
      "value": "2",
      "instruction": "Freshdesk default priority for Jira-created tickets. Freshdesk values are 1 Low, 2 Medium, 3 High, 4 Urgent."
    },
    {
      "name": "FRESHDESK_DEFAULT_STATUS",
      "behavior": "SET",
      "value": "2",
      "instruction": "Freshdesk default status for Jira-created tickets. Freshdesk value 2 is Open."
    },
    {
      "name": "FRESHDESK_TICKET_SOURCE",
      "behavior": "SET",
      "value": "2",
      "instruction": "Freshdesk source value for Jira-created tickets."
    },
    {
      "name": "FRESHDESK_COMMENT_PRIVATE",
      "behavior": "SET",
      "value": "true",
      "instruction": "Whether Jira comments should be added to Freshdesk as private notes."
    }
  ],
  "groupName": "Freshdesk",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "Freshdesk Outgoing Sync",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
