      "body": "{\n  \"subject\": \"{{{issue.fields.summary}}}\",\n  \"description\": \"<p>Synced from <strong>Jira</strong></p><p>Issue: {{issue.key}}</p>{{{adfToHTML issue.fields.description}}}\",\n  \"email\": \"{{_flow.FRESHDESK_REQUESTER_EMAIL}}\",\n  \"priority\": {{_flow.FRESHDESK_DEFAULT_PRIORITY}},\n  \"status\": {{_flow.FRESHDESK_DEFAULT_STATUS}},\n  \"source\": {{_flow.FRESHDESK_TICKET_SOURCE}}\n}",
      "logConditionsNotMet": false,
      "enabled": true,
