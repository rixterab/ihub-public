{
  "actions": [
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        }
      ],
      "method": "POST",
      "description": "Create a Bitbucket Cloud issue from a Jira work item.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-bitbucket"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"title\": \"{{issue.key}} - {{issue.fields.summary}}\",\n  \"content\": {\n    \"raw\": \"Created from Jira: {{baseUrl}}/browse/{{issue.key}}\\n\\nType: {{issue.fields.issuetype.name}}\\nPriority: {{#if issue.fields.priority.name}}{{issue.fields.priority.name}}{{else}}None{{/if}}\\nReporter: {{#if issue.fields.reporter.displayName}}{{issue.fields.reporter.displayName}}{{else}}Unknown{{/if}}\\n\\n{{issue.fields.description}}\"\n  },\n  \"kind\": \"bug\",\n  \"priority\": \"major\"\n}",
      "enabled": true,
      "url": "https://api.bitbucket.org/2.0/repositories/{{_flow.BITBUCKET_WORKSPACE}}/{{_flow.BITBUCKET_REPO_SLUG}}/issues",
      "parentId": "",
      "flowVariables": [
        {
          "name": "bitbucketIssueId",
          "behavior": "SET",
          "value": "$.response.data.id",
          "instruction": "ID of the created Bitbucket issue."
        }
      ],
      "name": "Create Bitbucket Issue",
      "id": "template:action:a3e24b01-baa5-4e95-aee3-7df4ed79c611",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS"
            },
            {
              "jsonPath": "$.issue.fields.project.key",
              "type": "DATA_CONDITION",
              "value": "{{_flow.SPACE}}",
              "operator": "EQUALS"
            }
          ]
        }
      ],
      "ratelimit": {
        "sleepTime": 1000,
        "initialSleepTime": 5000,
        "maxRetries": 1,
        "burst": 10,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "order": 100
    }
  ],
  "description": "Create a Bitbucket Cloud issue when a Jira work item is created",
  "enabled": false,
  "flowVariables": [
    {
      "name": "SPACE",
      "behavior": "SET",
      "value": "BITBUCKET",
      "instruction": "Jira project key to sync from."
    },
    {
      "name": "BITBUCKET_WORKSPACE",
      "behavior": "SET",
      "value": "workspace-id",
      "instruction": "Bitbucket workspace slug."
    },
    {
      "name": "BITBUCKET_REPO_SLUG",
      "behavior": "SET",
      "value": "repository-slug",
      "instruction": "Bitbucket repository slug."
    }
  ],
  "groupName": "Bitbucket",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "Bitbucket - Create Issue from Jira",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
