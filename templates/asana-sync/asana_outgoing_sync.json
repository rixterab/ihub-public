      "id": "template:action:0bcb12eb-0ca0-4ec4-bc77-bc0ff402221a",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10200",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if Asana Task GID exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create Asana tasks for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
    },
