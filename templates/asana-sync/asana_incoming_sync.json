      "method": "POST",
      "iterator": "$.events",
      "scriptedVariables": [
        {
          "name": "asanaResourceType",
          "uuid": "1787143421872",
          "script": "return scope?.resource?.resource_type || '';"
        },
        {
          "name": "asanaAction",
          "uuid": "1787143421873",
          "script": "return scope?.action || '';"
        },
        {
          "name": "asanaTaskGid",
          "uuid": "1787145100767",
          "script": "if (scope?.resource?.resource_type === 'task') return scope.resource.gid || '';\nreturn scope?.parent?.gid || '';"
        },
        {
          "name": "asanaStoryGid",
          "uuid": "1787145100768",
          "script": "return scope?.resource?.resource_type === 'story' ? (scope.resource.gid || '') : '';"
        },
        {
          "name": "asanaAttachmentGid",
          "uuid": "1787145100769",
          "script": "return scope?.resource?.resource_type === 'attachment' ? (scope.resource.gid || '') : '';"
        },
        {
          "name": "asanaEventType",
          "uuid": "1787145100770",
          "script": "const type = scope?.resource?.resource_type;\nconst action = scope?.action;\nif (type === 'task' && action === 'added') return 'task.created';\nif (type === 'story' && action === 'added') return 'task.commented';\nif (type === 'attachment' && action === 'added') return 'task.attachment.created';\nreturn '';"
        }
      ],
      "description": "Search for a Jira issue whose Asana Task GID custom field matches the incoming Task GID.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"jql\": \"project = {{_flow.SPACE}} AND \\\"cf[10200]\\\" ~ \\\"{{asanaTaskGid}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"status\",\n    \"assignee\",\n    \"issuetype\"\n  ]\n}",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/search/jql",
      "parentId": "",
      "flowVariables": [
        {
          "name": "issueKey",
          "behavior": "SET",
          "value": "$.response.data.issues[0].key",
          "instruction": ""
        }
      ],
      "name": "Find Jira Issue by Asana Task GID",
      "id": "template:action:82c6f96b-6ff7-490a-8d05-ca4ecdf012dd",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.asanaTaskGid",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS",
              "description": "Incoming Asana event must resolve to a Task GID"
            }
          ]
        }
      ],
      "order": 100
