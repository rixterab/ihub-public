          "name": "formattedGroups",
          "uuid": "63f91031-a093-43e5-8107-5144536bb344",
          "script": "const responseData = typeof response !== \"undefined\" ? response?.data : undefined;\nconst payloadData = typeof payload !== \"undefined\" ? payload : undefined;\nconst scopedGroups = typeof groups !== \"undefined\" ? groups : undefined;\nconst input = responseData?.groups ?? payloadData?.groups ?? scopedGroups ?? [];\nif (!Array.isArray(input)) return [];\nreturn input.map((group) => {\n  const item = group ?? {};\n  return {\n    ...item,\n    group_id: item.group_id !== undefined && item.group_id !== null ? String(item.group_id) : item.group_id\n  };\n});"
        }
      ],
      "uiRenderer": "WEB_ACTION",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:token-zoho-group-asset-import-token"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"data\": {\n    \"groups\": {{{toJSON formattedGroups}}}\n  }\n}",
