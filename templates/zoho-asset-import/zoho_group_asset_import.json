      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"$schema\": \"https://api.atlassian.com/jsm/assets/imports/external/schema/versions/2023_10_19\",\n  \"schema\": {\n    \"objectSchema\": {\n      \"name\": \"{{_flow.assetSchema}}\",\n      \"description\": \"Zoho MDM data imported from ManageEngine\",\n      \"objectTypes\": [\n        {\n          \"name\": \"Groups\",\n          \"description\": \"Device groups from Zoho MDM\",\n          \"attributes\": [\n            {\n              \"name\": \"group_id\",\n              \"description\": \"Zoho MDM group id\",\n              \"type\": \"text\",\n              \"label\": false,\n              \"unique\": true,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"name\",\n              \"description\": \"Group name\",\n              \"type\": \"text\",\n              \"label\": true,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"group_type\",\n              \"description\": \"Zoho MDM group type\",\n              \"type\": \"integer\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"domain\",\n              \"description\": \"Group domain\",\n              \"type\": \"text\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            }\n          ]\n        }\n      ]\n    }\n  },\n  \"mapping\": {\n    \"objectTypeMappings\": [\n      {\n        \"objectTypeName\": \"Groups\",\n        \"selector\": \"groups\",\n        \"description\": \"Device groups from Zoho MDM\",\n        \"attributesMapping\": [\n          {\n            \"attributeName\": \"group_id\",\n            \"attributeLocators\": [\n              \"group_id\"\n            ],\n            \"externalIdPart\": true\n          },\n          {\n            \"attributeName\": \"name\",\n            \"attributeLocators\": [\n              \"name\"\n            ]\n          },\n          {\n            \"attributeName\": \"group_type\",\n            \"attributeLocators\": [\n              \"group_type\"\n            ]\n          },\n          {\n            \"attributeName\": \"domain\",\n            \"attributeLocators\": [\n              \"domain\"\n            ]\n          }\n        ]\n      }\n    ]\n  }\n}",
      "parentId": "",
      "enabled": true,
