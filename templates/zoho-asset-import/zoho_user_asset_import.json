      "scriptedVariables": [
        {
          "name": "formattedUsers",
          "uuid": "edbcbd82-e7bd-49d2-ab0f-ad3f2f193713",
          "script": "const responseData = typeof response !== \"undefined\" ? response?.data : undefined;\nconst payloadData = typeof payload !== \"undefined\" ? payload : undefined;\nconst scopedUsers = typeof users !== \"undefined\" ? users : undefined;\nconst input = responseData?.users ?? payloadData?.users ?? scopedUsers ?? [];\nif (!Array.isArray(input)) return [];\nreturn input.map((user) => {\n  const item = user ?? {};\n  return {\n    ...item,\n    user_id: item.user_id !== undefined && item.user_id !== null ? String(item.user_id) : item.user_id\n  };\n});"
        }
      ],
      "uiRenderer": "WEB_ACTION",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:token-zoho-user-asset-import-token"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"data\": {\n    \"users\": {{{toJSON formattedUsers}}}\n  }\n}",
