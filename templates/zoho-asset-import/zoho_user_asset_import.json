      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"$schema\": \"https://api.atlassian.com/jsm/assets/imports/external/schema/versions/2023_10_19\",\n  \"schema\": {\n    \"objectSchema\": {\n      \"name\": \"{{_flow.assetSchema}}\",\n      \"description\": \"Zoho MDM data imported from ManageEngine\",\n      \"objectTypes\": [\n        {\n          \"name\": \"Users\",\n          \"description\": \"Managed users from Zoho MDM\",\n          \"attributes\": [\n            {\n              \"name\": \"user_id\",\n              \"description\": \"Zoho MDM user id\",\n              \"type\": \"text\",\n              \"label\": false,\n              \"unique\": true,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"name\",\n              \"description\": \"Managed user name\",\n              \"type\": \"text\",\n              \"label\": true,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"email_address\",\n              \"description\": \"Managed user email address\",\n              \"type\": \"email\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"phone_number\",\n              \"description\": \"Managed user phone number\",\n              \"type\": \"text\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            },\n            {\n              \"name\": \"domain\",\n              \"description\": \"User domain\",\n              \"type\": \"text\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": 1\n            }\n          ]\n        }\n      ]\n    }\n  },\n  \"mapping\": {\n    \"objectTypeMappings\": [\n      {\n        \"objectTypeName\": \"Users\",\n        \"selector\": \"users\",\n        \"description\": \"Managed users from Zoho MDM\",\n        \"attributesMapping\": [\n          {\n            \"attributeName\": \"user_id\",\n            \"attributeLocators\": [\n              \"user_id\"\n            ],\n            \"externalIdPart\": true\n          },\n          {\n            \"attributeName\": \"name\",\n            \"attributeLocators\": [\n              \"name\"\n            ]\n          },\n          {\n            \"attributeName\": \"email_address\",\n            \"attributeLocators\": [\n              \"email_address\"\n            ]\n          },\n          {\n            \"attributeName\": \"phone_number\",\n            \"attributeLocators\": [\n              \"phone_number\"\n            ]\n          },\n          {\n            \"attributeName\": \"domain\",\n            \"attributeLocators\": [\n              \"domain\"\n            ]\n          }\n        ]\n      }\n    ]\n  }\n}",
      "parentId": "",
      "enabled": true,
