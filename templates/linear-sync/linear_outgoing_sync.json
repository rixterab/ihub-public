      "scriptedVariables": [
        {
          "name": "jiraDescriptionText",
          "uuid": "1787601001001",
          "script": "const toText = (node) => {\n  if (node === null || node === undefined) return '';\n  if (typeof node === 'string') return node;\n  if (Array.isArray(node)) return node.map(toText).join('');\n  if (typeof node !== 'object') return String(node);\n  const attrs = node.attrs || {};\n  if (node.type === 'text') return node.text || '';\n  if (node.type === 'hardBreak') return '\\n';\n  if (node.type === 'mention') return attrs.text || '';\n  if (node.type === 'emoji') return attrs.text || attrs.shortName || '';\n  if (node.type === 'inlineCard' || node.type === 'blockCard' || node.type === 'embedCard') return attrs.url || '';\n  if (node.type === 'media') return attrs.alt || attrs.id || '';\n  if (node.type === 'rule') return '\\n';\n  const inner = toText(node.content);\n  const blocks = ['paragraph', 'heading', 'blockquote', 'codeBlock', 'listItem', 'panel', 'mediaSingle', 'mediaGroup', 'tableRow'];\n  return blocks.indexOf(node.type) >= 0 ? inner + '\\n' : inner;\n};\nconst jsonEscape = (value) => String(value)\n  .replace(/\\\\/g, '\\\\\\\\')\n  .replace(/\"/g, '\\\\\"')\n  .replace(/\\r/g, '')\n  .replace(/\\n/g, '\\\\n')\n  .replace(/\\t/g, '\\\\t');\nconst issue = (scope && scope.issue) || (scope && scope.payload && scope.payload.issue) || {};\nconst fields = issue.fields || {};\nconst description = fields.description;\nconst text = toText(description).replace(/\\n{3,}/g, '\\n\\n').trim();\nreturn jsonEscape(text);"
        },
        {
          "name": "jiraCommentText",
          "uuid": "1787601001002",
          "script": "const toText = (node) => {\n  if (node === null || node === undefined) return '';\n  if (typeof node === 'string') return node;\n  if (Array.isArray(node)) return node.map(toText).join('');\n  if (typeof node !== 'object') return String(node);\n  const attrs = node.attrs || {};\n  if (node.type === 'text') return node.text || '';\n  if (node.type === 'hardBreak') return '\\n';\n  if (node.type === 'mention') return attrs.text || '';\n  if (node.type === 'emoji') return attrs.text || attrs.shortName || '';\n  if (node.type === 'inlineCard' || node.type === 'blockCard' || node.type === 'embedCard') return attrs.url || '';\n  if (node.type === 'media') return attrs.alt || attrs.id || '';\n  if (node.type === 'rule') return '\\n';\n  const inner = toText(node.content);\n  const blocks = ['paragraph', 'heading', 'blockquote', 'codeBlock', 'listItem', 'panel', 'mediaSingle', 'mediaGroup', 'tableRow'];\n  return blocks.indexOf(node.type) >= 0 ? inner + '\\n' : inner;\n};\nconst jsonEscape = (value) => String(value)\n  .replace(/\\\\/g, '\\\\\\\\')\n  .replace(/\"/g, '\\\\\"')\n  .replace(/\\r/g, '')\n  .replace(/\\n/g, '\\\\n')\n  .replace(/\\t/g, '\\\\t');\nconst comment = (scope && scope.comment) || (scope && scope.payload && scope.payload.comment) || {};\nconst body = comment.body !== undefined ? comment.body : comment.value;\nconst text = toText(body).replace(/\\n{3,}/g, '\\n\\n').trim();\nreturn jsonEscape(text);"
        }
      ],
      "method": "POST",
      "description": "Look up an existing Linear attachment pointing at this Jira issue, so an issue that is already linked is never created twice.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-linear-api-key"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"query\": \"query AttachmentsForURL($url: String!) { attachmentsForURL(url: $url) { nodes { id url issue { id identifier title } } } }\",\n  \"variables\": {\n    \"url\": \"{{baseUrl}}/browse/{{issue.key}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.LINEAR_API_URL}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "linkedLinearIssueId",
