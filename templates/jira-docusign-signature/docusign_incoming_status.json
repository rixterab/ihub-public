      "scriptedVariables": [
        {
          "name": "docusignEnvelopeId",
          "uuid": "56d228e6-0850-4fb9-b44d-f516fde2906c",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => {\n      if (obj == null) return undefined;\n      if (/^\\d+$/.test(key) && Array.isArray(obj)) return obj[Number(key)];\n      return obj[key];\n    }, root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('data.envelopeId', 'data.envelopeSummary.envelopeId', 'envelopeId', 'envelopeSummary.envelopeId', 'DocuSignEnvelopeInformation.EnvelopeStatus.EnvelopeID', 'EnvelopeStatus.EnvelopeID');"
        },
        {
          "name": "docusignRawStatus",
          "uuid": "724ba3dc-43f7-40ad-abb1-55b867b9d619",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => {\n      if (obj == null) return undefined;\n      if (/^\\d+$/.test(key) && Array.isArray(obj)) return obj[Number(key)];\n      return obj[key];\n    }, root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('data.envelopeSummary.status', 'envelopeSummary.status', 'status', 'data.status', 'event', 'DocuSignEnvelopeInformation.EnvelopeStatus.Status', 'EnvelopeStatus.Status');"
        },
        {
          "name": "docusignNormalizedStatus",
          "uuid": "ee9d77b7-da7a-49f3-b443-cd0237d2957f",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => {\n      if (obj == null) return undefined;\n      if (/^\\d+$/.test(key) && Array.isArray(obj)) return obj[Number(key)];\n      return obj[key];\n    }, root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nconst raw = String(read('data.envelopeSummary.status', 'envelopeSummary.status', 'status', 'data.status', 'event', 'DocuSignEnvelopeInformation.EnvelopeStatus.Status', 'EnvelopeStatus.Status') || '').toLowerCase();\nif (raw.includes('completed') || raw.includes('signed')) return 'completed';\nif (raw.includes('delivered')) return 'delivered';\nif (raw.includes('sent')) return 'sent';\nreturn raw;"
        },
        {
          "name": "jiraSignatureStatus",
          "uuid": "a24c81e3-be58-4733-ac26-a976a4076210",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => {\n      if (obj == null) return undefined;\n      if (/^\\d+$/.test(key) && Array.isArray(obj)) return obj[Number(key)];\n      return obj[key];\n    }, root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nconst raw = String(read('data.envelopeSummary.status', 'envelopeSummary.status', 'status', 'data.status', 'event', 'DocuSignEnvelopeInformation.EnvelopeStatus.Status', 'EnvelopeStatus.Status') || '').toLowerCase();\nif (raw.includes('completed') || raw.includes('signed')) return 'Signed';\nif (raw.includes('delivered')) return 'Delivered';\nif (raw.includes('sent')) return 'Sent';\nreturn raw;"
        }
      ],
      "description": "Find the Jira issue whose DocuSign envelopeId field matches the incoming DocuSign webhook event.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
