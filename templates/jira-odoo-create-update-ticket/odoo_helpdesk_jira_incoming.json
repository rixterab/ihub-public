{
  "actions": [
    {
      "body": "{\n  \"jql\": \"project = {{_flow.SPACE}} AND \\\"cf[10153]\\\" ~ \\\"{{odooTicketId}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"description\",\n    \"status\",\n    \"issuetype\"\n  ]\n}",
      "conditions": [
        {
          "conditions": [
            {
              "description": "Incoming Odoo payload must include a ticket ID",
              "expectedValueSource": "FIXED_VALUE",
              "jsonPath": "$.id",
              "operator": "NOT_EQUALS",
              "type": "DATA_CONDITION",
              "value": ""
            }
          ],
          "type": "COMBINED_CONDITION"
        }
      ],
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
