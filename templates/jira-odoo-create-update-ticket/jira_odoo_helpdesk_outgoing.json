  "description": "Synchronize Jira work items and Odoo Helpdesk tickets in both directions, including comments and attachments.\nhttps://www.odoo.com/documentation/19.0/developer/reference/external_api.html",
  "enabled": false,
  "flowVariables": [
    {
      "behavior": "SET",
      "instruction": "Jira project key whose work items are synchronized with Odoo Helpdesk.",
      "name": "SPACE",
      "value": "ODOO"
    },
    {
      "behavior": "SET",
      "instruction": "Base URL of the Odoo instance, without a trailing slash.",
      "name": "ODOO_URL",
      "value": "https://replace-with-yoursite.odoo.com"
    },
    {
      "behavior": "SET",
      "instruction": "Numeric Odoo Helpdesk team ID that receives Jira-created tickets.",
      "name": "ODOO_HELPDESK_TEAM_ID",
      "value": "1"
    },
    {
      "behavior": "SET",
      "instruction": "Atlassian account ID used by iHub for Jira writes; used to prevent sync loops.",
      "name": "JIRA_INTEGRATION_ACCOUNT_ID",
      "value": "712020:replace-with-ihub-integration-user"
    },
    {
      "behavior": "SET",
      "instruction": "",
      "name": "DATABASE",
      "value": "replace-with-yoursite"
    }
  ],
