    {
      "body": "{\n    \"ids\": [{{issue.fields.customfield_10153}}],\n    \"body\": \"<p>Synced from <strong>Jira</strong></p><p>Status: {{issue.fields.status.name}}</p><p>Work Item: {{issue.key}}</p><p>{{lookupUser comment.author.accountId displayName}}: {{lookupEmail comment.author.accountId}}</p><p>{{{adfToHTML payload.comment.body}}}</p>\",\n    \"message_type\": \"comment\",\n      \"body_is_html\": true,\n    \"subtype_xmlid\": \"mail.mt_comment\"\n  }",
      "conditions": [
        {
          "conditions": [
            {
              "description": "Only sync comments for the configured Jira project",
              "expectedValueSource": "MUSTACHE",
              "jsonPath": "$.issue.fields.project.key",
              "operator": "EQUALS",
              "type": "DATA_CONDITION",
              "value": "{{_flow.SPACE}}"
            },
            {
              "description": "Only sync comments for a linked Odoo ticket",
              "expectedValueSource": "FIXED_VALUE",
              "jsonPath": "$.issue.fields.customfield_10153",
              "operator": "NOT_EQUALS",
              "type": "DATA_CONDITION",
              "value": ""
            },
            {
              "description": "Only run for Jira comment events",
              "expectedValueSource": "FIXED_VALUE",
              "jsonPath": "$.eventType",
              "operator": "EQUALS",
              "type": "DATA_CONDITION",
              "value": "avi:jira:commented:issue"
            },
            {
              "description": "Block comments created by the Jira integration user",
