          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "name": "Store Matrix42 Attachment ID",
      "description": "Store the Matrix42 attachment id on the Jira issue to prevent sync loops.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "id": "template:action:1c6d8b40-3f57-4a92-b8e3-9a2f5c704d18",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"externalId\": \"{{_flow.attachmentId}}\",\n  \"status\": \"synced\",\n  \"source\": \"matrix42\"\n}",
      "parentId": "template:action:e71b3f95-8d24-4c60-a1f8-05c9b7e2d463",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}/properties/ihub-{{_flow.attachmentId}}",
      "order": 700
    }
  ],
  "description": "Sync Jira issues to Matrix42 tickets",
  "enabled": false,
  "flowVariables": [
    {
      "name": "M42_URL",
      "behavior": "SET",
      "value": "https://your-instance.matrix42.cloud",
      "instruction": "Matrix42 instance base URL"
    },
    {
      "name": "M42_API_PATH",
      "behavior": "SET",
      "value": "M42Services/api/odata/v3",
      "instruction": "Matrix42 OData API path, confirm against the tenant's $metadata document"
    },
    {
      "name": "M42_ENTITY",
      "behavior": "SET",
      "value": "Tickets",
      "instruction": "Matrix42 OData entity set holding the tickets, for example Tickets, Incidents or SDIssues"
    }
  ],
  "groupName": "Matrix42",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "Matrix42 Outgoing Sync",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
