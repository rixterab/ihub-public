      "method": "POST",
      "description": "Create a Matrix42 ticket when a Jira issue without a linked ticket id is created.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-matrix42"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"Subject\": \"{{{issue.fields.summary}}}\",\n  \"Description\": \"{{{adfToHTML issue.fields.description}}}\",\n  \"ExternalReference\": \"{{issue.key}}\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.M42_URL}}/{{_flow.M42_API_PATH}}/{{_flow.M42_ENTITY}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "ticketId",
          "behavior": "SET",
          "value": "$.response.data.Id",
          "instruction": ""
        },
        {
          "name": "displayName",
          "behavior": "SET",
          "value": "$.response.data.DisplayName",
          "instruction": ""
        }
      ],
      "name": "Create Ticket in Matrix42",
      "id": "template:action:c58a1e74-0d92-4f36-8b17-6a2e9c4d3f81",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if a Matrix42 ticket id already exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create Matrix42 tickets for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "description": "Store the created Matrix42 ticket id on the Jira issue.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"fields\": {\n    \"customfield_10153\": \"{{_flow.ticketId}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}",
      "parentId": "template:action:c58a1e74-0d92-4f36-8b17-6a2e9c4d3f81",
      "flowVariables": [],
      "name": "Store Matrix42 Ticket Id on Jira Issue",
      "id": "template:action:2d94f6b1-7e35-48c0-9a6d-1b8f5c07e2a4",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only update the Jira issue after a create event"
            }
          ]
        }
      ],
      "order": 200
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "POST",
      "description": "Add the Jira comment to the linked Matrix42 ticket as a note.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-matrix42"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"TicketId\": \"{{issue.fields.customfield_10153}}\",\n  \"Text\": \"Synced from Jira issue {{issue.key}} (status: {{issue.fields.status.name}})\\n{{{adfToHTML payload.comment.body}}}\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.M42_URL}}/{{_flow.M42_API_PATH}}/Notes",
      "parentId": "",
      "flowVariables": [
        {
          "name": "ticketId",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        }
      ],
      "name": "Add Note to Matrix42 Ticket",
      "id": "template:action:9f13c5e8-4a70-4d29-b53e-8c1a6d2f0b97",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:commented:issue",
              "operator": "EQUALS"
            },
            {
              "jsonPath": "$.comment.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "User shall not be iHub"
            }
          ]
        }
      ],
      "order": 300
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "name": "Store Outgoing Comment ID",
      "description": "Mark the Jira comment as synced to Matrix42 to prevent sync loops.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "id": "template:action:6b47e0d3-1c58-49a2-8f61-3d9e7a5c4b02",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"externalId\": \"{{comment.id}}\",\n  \"status\": \"synced\",\n  \"source\": \"jira\"\n}",
      "parentId": "template:action:9f13c5e8-4a70-4d29-b53e-8c1a6d2f0b97",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}/properties/ihub-{{comment.id}}",
      "order": 400
    },
    {
      "ratelimit": {
        "sleepTime": 500,
        "initialSleepTime": 5000,
        "maxRetries": 0,
        "burst": 20,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
