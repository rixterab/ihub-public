        }
      ],
      "method": "PATCH",
      "description": "Update the linked Matrix42 ticket when the Jira issue is updated.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-matrix42"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"Subject\": \"{{{issue.fields.summary}}}\",\n  \"Description\": \"{{{adfToHTML issue.fields.description}}}\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.M42_URL}}/{{_flow.M42_API_PATH}}/{{_flow.M42_ENTITY}}({{issue.fields.customfield_10153}})",
      "parentId": "",
      "flowVariables": [
        {
          "name": "ticketId",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        }
      ],
      "name": "Update Matrix42 Ticket",
      "id": "template:action:4a80d2c6-5b19-43e7-9c02-7f6b1e8d5a39",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:updated:issue",
              "operator": "EQUALS"
            }
          ]
        }
      ],
      "order": 500
    },
    {
      "headers": [
        {
          "value": "application/octet-stream",
          "key": "Content-Type"
        },
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "POST",
      "description": "Upload Jira attachments to the linked Matrix42 ticket.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-matrix42"
      },
      "logNoIterationItemsFound": false,
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"file\": \"{{attachments.unsentFile}}\"\n}",
      "logConditionsNotMet": false,
      "parentId": "",
      "enabled": true,
      "url": "{{_flow.M42_URL}}/{{_flow.M42_API_PATH}}/Attachments?TicketId={{issue.fields.customfield_10153}}&FileName={{filename}}",
      "iterator": "$.payload.issue.fields.attachment",
      "flowVariables": [
        {
          "name": "attachmentId",
          "behavior": "SET",
          "value": "$.response.data.Id",
          "instruction": ""
        }
      ],
      "name": "Upload Attachment to Matrix42 Ticket",
      "id": "template:action:e71b3f95-8d24-4c60-a1f8-05c9b7e2d463",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS",
              "description": "Only upload attachments when the Jira issue has a Matrix42 ticket id"
            },
            {
              "jsonPath": "$.payload.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "Block attachments added by the iHub user"
            }
          ]
        }
      ],
      "order": 600,
      "contextLogAppender": "{{eventType}}"
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
