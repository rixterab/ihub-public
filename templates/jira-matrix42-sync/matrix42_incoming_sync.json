      "description": "Search for a Jira issue whose Matrix42 ticket id custom field matches the incoming ticket.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"jql\": \"project = {{_flow.SPACE}} AND \\\"cf[10153]\\\" ~ \\\"{{matrix42TicketId}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"status\",\n    \"assignee\",\n    \"issuetype\"\n  ]\n}",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/search/jql",
      "parentId": "",
      "flowVariables": [
        {
          "name": "issueKey",
          "behavior": "SET",
          "value": "$.response.data.issues[0].key",
          "instruction": ""
        }
