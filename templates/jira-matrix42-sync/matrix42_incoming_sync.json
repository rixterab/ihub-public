      "scriptedVariables": [
        {
          "name": "matrix42EventType",
          "uuid": "1787643421001",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nconst eventType = read('eventType', 'EventType', 'event_type', 'type', 'Type', 'action', 'Action', 'operation', 'Operation');\nif (eventType) {\n  const normalized = String(eventType).toLowerCase();\n  if (normalized === 'insert' || normalized === 'create' || normalized === 'created') return 'ticket.created';\n  if (normalized === 'update' || normalized === 'updated') return 'ticket.updated';\n  return eventType;\n}\nif (read('noteId', 'NoteId', 'note.Id', 'commentId', 'CommentId')) return 'ticket.commented';\nif (read('attachmentId', 'AttachmentId', 'attachment.Id')) return 'ticket.attachment.created';\nif (read('ticketId', 'TicketId', 'Id', 'ticket.Id', 'entity.Id')) return 'ticket.created';\nreturn '';"
        },
        {
          "name": "matrix42TicketId",
          "uuid": "1787643421002",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('ticketId', 'TicketId', 'Id', 'ticket.Id', 'entity.Id', 'ObjectId', 'objectId');"
        },
        {
          "name": "matrix42DisplayName",
          "uuid": "1787643421003",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('displayName', 'DisplayName', 'ticket.DisplayName', 'entity.DisplayName', 'number', 'Number');"
        },
        {
          "name": "matrix42Subject",
          "uuid": "1787643421004",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nconst subject = read('subject', 'Subject', 'title', 'Title', 'ticket.Subject', 'entity.Subject');\nif (subject) return subject;\nconst displayName = read('displayName', 'DisplayName', 'number', 'Number');\nconst ticketId = read('ticketId', 'TicketId', 'Id', 'ticket.Id', 'entity.Id');\nif (displayName) return 'Matrix42 ' + displayName;\nreturn ticketId ? 'Matrix42 ticket ' + ticketId : 'Matrix42 ticket';"
        },
        {
          "name": "matrix42Description",
          "uuid": "1787643421005",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('description', 'Description', 'ticket.Description', 'entity.Description');"
        },
        {
          "name": "matrix42NoteId",
          "uuid": "1787643421006",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('noteId', 'NoteId', 'note.Id', 'commentId', 'CommentId', 'comment.Id');"
        },
        {
          "name": "matrix42NoteBody",
          "uuid": "1787643421007",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('noteBody', 'NoteBody', 'note.Text', 'note.Body', 'commentBody', 'CommentBody', 'comment.Text', 'text', 'Text');"
        },
        {
          "name": "matrix42AttachmentId",
          "uuid": "1787643421008",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('attachmentId', 'AttachmentId', 'attachment.Id');"
        },
        {
          "name": "matrix42FileName",
          "uuid": "1787643421009",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst read = (...paths) => {\n  for (const path of paths) {\n    const value = path.split('.').reduce((obj, key) => obj == null ? undefined : obj[key], root);\n    if (value !== undefined && value !== null && String(value).trim() !== '') return value;\n  }\n  return '';\n};\nreturn read('fileName', 'FileName', 'attachment.FileName') || 'matrix42-file';"
        }
