{
  "actions": [
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "POST",
      "description": "Post a Jira work item created event to New Relic.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-new-relic-insert-key"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"eventType\": \"JiraWorkItemEvent\",\n  \"jiraIssueKey\": \"{{issue.key}}\",\n  \"jiraProjectKey\": \"{{issue.fields.project.key}}\",\n  \"summary\": \"{{{issue.fields.summary}}}\",\n  \"priority\": \"{{#if issue.fields.priority.name}}{{{issue.fields.priority.name}}}{{else}}None{{/if}}\",\n  \"issueUrl\": \"{{baseUrl}}/browse/{{issue.key}}\"\n}",
      "enabled": true,
      "url": "{{_flow.NEW_RELIC_INSERT_URL}}/v1/accounts/{{_flow.NEW_RELIC_ACCOUNT_ID}}/events",
      "parentId": "",
      "name": "Post New Relic Event",
      "id": "template:action:f7d6e8c2-f58b-4135-a8bc-d5b8f4dba687",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only run for Jira work item created events"
            },
            {
              "jsonPath": "$.issue.fields.project.key",
              "type": "DATA_CONDITION",
              "value": "{{_flow.SPACE}}",
              "operator": "EQUALS",
              "description": "Only run for the configured Jira project"
            }
          ]
        }
      ],
      "ratelimit": {
        "sleepTime": 1000,
        "initialSleepTime": 5000,
        "maxRetries": 1,
        "burst": 10,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "order": 100,
      "logConditionsNotMet": false
    }
  ],
  "description": "Post a Jira work item event into New Relic",
  "enabled": false,
  "flowVariables": [
    {
      "name": "SPACE",
      "behavior": "SET",
      "value": "NEWRELIC",
      "instruction": "Jira project key to monitor."
    },
    {
      "name": "NEW_RELIC_ACCOUNT_ID",
      "behavior": "SET",
      "value": "1234567",
      "instruction": "New Relic account ID."
    },
    {
      "name": "NEW_RELIC_INSERT_URL",
      "behavior": "SET",
      "value": "https://insights-collector.newrelic.com",
      "instruction": "New Relic Events API insert URL. Use the EU endpoint where applicable."
    }
  ],
  "groupName": "New Relic",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "New Relic - Post Event from Jira",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
