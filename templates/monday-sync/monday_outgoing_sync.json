      "method": "POST",
      "description": "Look up an existing monday item carrying this Jira issue key, so a retried or re-linked issue does not create a duplicate item.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-monday-api-token"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"query\": \"query FindItemByJiraKey($boardId: ID!, $columnId: String!, $jiraKey: String!) {\\n  items_page_by_column_values(limit: 1, board_id: $boardId, columns: [{column_id: $columnId, column_values: [$jiraKey]}]) {\\n    cursor\\n    items {\\n      id\\n      name\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"boardId\": \"{{_flow.MONDAY_BOARD_ID}}\",\n    \"columnId\": \"{{_flow.MONDAY_JIRA_KEY_COLUMN}}\",\n    \"jiraKey\": \"{{issue.key}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "https://api.monday.com/v2",
      "parentId": "",
      "flowVariables": [
        {
          "name": "mondayItemId",
          "behavior": "SET",
          "value": "$.response.data.data.items_page_by_column_values.items[0].id",
          "instruction": ""
        }
      ],
      "name": "Find Monday Item by Jira Key",
      "id": "template:action:0b9e4d61-7c28-4a35-9f80-2e6a5c3b7d19",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Only look up when the Jira issue has no linked monday item ID"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS"
            }
          ]
        }
      ],
      "order": 50
