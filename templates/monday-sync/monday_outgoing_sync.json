      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"query\": \"mutation CreateItem($boardId: ID!, $groupId: String!, $itemName: String!, $columnValues: JSON!) {\\n  create_item(board_id: $boardId, group_id: $groupId, item_name: $itemName, column_values: $columnValues) {\\n    id\\n    name\\n  }\\n}\",\n  \"variables\": {\n    \"boardId\": \"{{_flow.MONDAY_BOARD_ID}}\",\n    \"groupId\": \"{{_flow.MONDAY_GROUP_ID}}\",\n    \"itemName\": \"{{{issue.fields.summary}}}\",\n    \"columnValues\": \"{\\\"{{_flow.MONDAY_JIRA_KEY_COLUMN}}\\\": \\\"{{issue.key}}\\\"}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "https://api.monday.com/v2",
      "parentId": "template:action:0b9e4d61-7c28-4a35-9f80-2e6a5c3b7d19",
