      "variables": [],
      "method": "POST",
      "scriptedVariables": [
        {
          "name": "remoteDescription",
          "uuid": "1787643421105",
          "script": "const root = scope && scope.payload && typeof scope.payload === 'object' ? scope.payload : scope;\n// Admin webhooks deliver this field as a wiki markup string or as ADF depending on how it was written.\n// ADF passes through; a string becomes one plain-text paragraph per non-empty line.\nconst toAdf = (value) => {\n  if (value && typeof value === 'object') return value;\n  const lines = typeof value === 'string' ? value.split(/\\r?\\n/).filter((line) => line.trim() !== '') : [];\n  return { type: 'doc', version: 1, content: lines.map((line) => ({ type: 'paragraph', content: [{ type: 'text', text: line }] })) };\n};\nreturn JSON.stringify(toAdf(root && root.issue && root.issue.fields ? root.issue.fields.description : null));"
        },
        {
          "name": "remoteCommentBody",
          "uuid": "1787643421110",
          "script": "const root = scope && scope.payload && typeof scope.payload === 'object' ? scope.payload : scope;\n// Admin webhooks deliver this field as a wiki markup string or as ADF depending on how it was written.\n// ADF passes through; a string becomes one plain-text paragraph per non-empty line.\nconst toAdf = (value) => {\n  if (value && typeof value === 'object') return value;\n  const lines = typeof value === 'string' ? value.split(/\\r?\\n/).filter((line) => line.trim() !== '') : [];\n  return { type: 'doc', version: 1, content: lines.map((line) => ({ type: 'paragraph', content: [{ type: 'text', text: line }] })) };\n};\nreturn JSON.stringify(toAdf(root && root.comment ? root.comment.body : null));"
        },
        {
          "name": "remoteLinkFieldOnlyChange",
          "uuid": "1787643421108",
          "script": "const root = scope && scope.payload && typeof scope.payload === 'object' ? scope.payload : scope;\n// True when every changelog entry is the link field, i.e. the event is only an iHub write-back.\nconst items = root && root.changelog && root.changelog.items;\nif (!Array.isArray(items) || items.length === 0) return 'false';\nreturn items.every((entry) => String(entry.fieldId || entry.field || '') === 'customfield_10200') ? 'true' : 'false';"
        },
        {
          "name": "remoteHasAttachmentChange",
          "uuid": "1787643421112",
          "script": "const root = scope && scope.payload && typeof scope.payload === 'object' ? scope.payload : scope;\n// True when the changelog has an Attachment entry; Jira has no dedicated attachment webhook event.\nconst items = root && root.changelog && root.changelog.items;\nif (!Array.isArray(items)) return 'false';\nreturn items.some((entry) => String(entry.field || entry.fieldId || '').toLowerCase() === 'attachment') ? 'true' : 'false';"
        }
      ],
      "description": "Search the local instance for the issue whose link field holds the incoming remote issue key.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"jql\": \"project = {{_flow.SPACE}} AND \\\"cf[10153]\\\" ~ \\\"{{issue.key}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"status\",\n    \"assignee\",\n    \"issuetype\"\n  ]\n}",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/search/jql",
      "parentId": "",
      "flowVariables": [
        {
          "name": "issueKey",
          "behavior": "SET",
          "value": "$.response.data.issues[0].key",
          "instruction": ""
        }
      ],
