              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Only create when the local issue is not already linked to a remote issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create remote issues for local issue created events"
            },
            {
              "jsonPath": "$.issue.fields.creator.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
