      "method": "POST",
      "description": "Search the remote instance for an issue whose link field already holds this local issue key, so a duplicate mirror is never created.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-remote-jira"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"jql\": \"project = {{_flow.REMOTE_PROJECT}} AND \\\"cf[10200]\\\" ~ \\\"{{issue.key}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"status\",\n    \"assignee\",\n    \"issuetype\"\n  ]\n}",
      "enabled": true,
      "url": "{{_flow.REMOTE_URL}}/rest/api/3/search/jql",
      "parentId": "",
      "flowVariables": [
        {
          "name": "remoteIssueKey",
          "behavior": "SET",
          "value": "$.response.data.issues[0].key",
          "instruction": ""
        }
      ],
      "name": "Find Remote Issue by Local Issue Key",
      "id": "template:action:6d2e9f15-8a43-4c70-b592-0d7f3a1c6e84",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only look for an existing mirror on local issue created events"
            },
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Only look when the local issue is not already linked to a remote issue"
            },
            {
              "jsonPath": "$.issue.fields.creator.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "Loop guard: skip issues created by the local iHub integration user"
            }
          ]
        }
      ],
      "order": 100
    },
