      "method": "POST",
      "description": "Create an issue in the remote Jira instance when a local issue without a remote issue key is created.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-remote-jira"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"fields\": {\n    \"project\": {\n      \"key\": \"{{_flow.REMOTE_PROJECT}}\"\n    },\n    \"summary\": \"{{issue.fields.summary}}\",\n    \"issuetype\": {\n      \"name\": \"{{_flow.REMOTE_ISSUE_TYPE}}\"\n    },\n    \"customfield_10200\": \"{{issue.key}}\",\n    \"description\": {{{toJSON issue.fields.description}}}\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.REMOTE_URL}}/rest/api/3/issue",
      "parentId": "template:action:6d2e9f15-8a43-4c70-b592-0d7f3a1c6e84",
