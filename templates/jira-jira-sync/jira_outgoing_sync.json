      "scriptedVariables": [
        {
          "name": "localLinkFieldOnlyChange",
          "uuid": "1787643421001",
          "script": "const root = scope?.payload && typeof scope.payload === 'object' ? scope.payload : scope;\nconst items = root?.changelog?.items;\nif (!Array.isArray(items) || items.length === 0) return 'false';\nconst linkFields = ['customfield_10153'];\nconst onlyLink = items.every((entry) => linkFields.includes(String(entry?.fieldId || entry?.field || '')));\nreturn onlyLink ? 'true' : 'false';"
        }
      ],
      "description": "Update the summary and description of the linked remote issue when the local issue is updated.",
