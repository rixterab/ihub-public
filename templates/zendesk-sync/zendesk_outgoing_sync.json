      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"ticket\": {\n    \"subject\": \"{{{issue.fields.summary}}}\",\n    \"comment\": {\n      \"html_body\": \"<p>Synced from <strong>Jira</strong></p><p>Issue: {{issue.key}}</p>{{{adfToHTML issue.fields.description}}}\",\n      \"public\": {{_flow.ZENDESK_INITIAL_COMMENT_PUBLIC}}\n    },\n    \"requester\": {\n      \"name\": \"{{_flow.ZENDESK_REQUESTER_NAME}}\",\n      \"email\": \"{{_flow.ZENDESK_REQUESTER_EMAIL}}\"\n    },\n    \"priority\": \"{{_flow.ZENDESK_DEFAULT_PRIORITY}}\",\n    \"status\": \"{{_flow.ZENDESK_DEFAULT_STATUS}}\",\n    \"external_id\": \"{{issue.key}}\",\n    \"tags\": [\n      \"jira\",\n      \"ihub-sync\"\n    ]\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.ZENDESK_URL}}/api/v2/tickets",
      "parentId": "",
      "flowVariables": [
        {
          "name": "zendeskTicketId",
          "behavior": "SET",
