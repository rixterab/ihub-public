      "name": "Create Ticket in Zendesk",
      "id": "template:action:80c8006c-b2cb-41dd-9cfd-425959ec08d3",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if Zendesk ticket ID exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create Zendesk tickets for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100,
      "description": "Creates a Zendesk ticket when a Jira issue without a linked Zendesk ticket ID is created."
    },
