  "description": "Sync Jira issues to Zendesk tickets",
  "enabled": false,
  "flowVariables": [
    {
      "name": "ZENDESK_URL",
      "behavior": "SET",
      "value": "https://your-subdomain.zendesk.com",
      "instruction": "Zendesk account URL, for example https://customer.zendesk.com"
    },
    {
      "name": "ZENDESK_REQUESTER_NAME",
      "behavior": "SET",
      "value": "Jira Sync",
      "instruction": "Requester name used when Jira creates Zendesk tickets"
    },
    {
      "name": "ZENDESK_REQUESTER_EMAIL",
      "behavior": "SET",
      "value": "jira-sync@example.com",
      "instruction": "Requester email used when Jira creates Zendesk tickets"
    },
    {
      "name": "ZENDESK_DEFAULT_PRIORITY",
      "behavior": "SET",
      "value": "normal",
      "instruction": "Zendesk default priority for Jira-created tickets. Common values are low, normal, high, urgent."
    },
    {
      "name": "ZENDESK_DEFAULT_STATUS",
      "behavior": "SET",
      "value": "new",
      "instruction": "Zendesk default status for Jira-created tickets. Common values are new, open, pending, hold, solved."
    },
    {
      "name": "ZENDESK_INITIAL_COMMENT_PUBLIC",
      "behavior": "SET",
      "value": "true",
      "instruction": "Whether the initial Jira description should be a public Zendesk comment."
    },
    {
      "name": "ZENDESK_COMMENT_PUBLIC",
      "behavior": "SET",
      "value": "false",
      "instruction": "Whether Jira comments and attachment comments should be public Zendesk comments."
    }
  ],
  "groupName": "Zendesk",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "Zendesk Outgoing Sync",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
