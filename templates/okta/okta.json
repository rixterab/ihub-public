  "description": "",
  "enabled": false,
  "flowVariables": [
    {
      "name": "OKTA_ADMIN_URL",
      "behavior": "SET",
      "value": "https://{yourOktaDomain}-admin.okta.com/api/v1",
      "instruction": "Okta admin API base URL for this customer's org, e.g. https://acme-admin.okta.com/api/v1. Used by app, role, policy, group, and user-type actions."
    },
    {
      "name": "OKTA_URL",
      "behavior": "SET",
      "value": "https://{yourOktaDomain}.okta.com/api/v1",
      "instruction": "Okta org API base URL for this customer's org, e.g. https://acme.okta.com/api/v1. Used by the app-scoped and group-scoped user lookup actions."
    },
    {
      "name": "SAMPLE_APP_ID",
      "behavior": "SET",
      "value": "",
      "instruction": "Okta app ID used by the 'Get Users in App' and 'Get Groups for app' example actions. Replace per customer, or remove those actions if a fixed app isn't needed."
    },
    {
      "name": "SAMPLE_GROUP_ID",
      "behavior": "SET",
      "value": "",
      "instruction": "Okta group ID used by the 'Users in Group' example action. Replace per customer, or remove the action if a fixed group isn't needed."
    }
  ],
