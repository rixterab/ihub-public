          "script": "var defaultLink = \"{{_flow.OKTA_ADMIN_URL}}/apps?limit=2\";\n\nif(response && response.headers && response.headers.link){\n    // Use regular expression to extract the URL with rel=\"next\"\n    const match = /<([^>]+)>;\\s*rel=\"next\"/.exec(response.headers.link);\n    const nextUrl = match && match[1];   \n    return nextUrl;\n}\nreturn defaultLink;"
        },
        "breakJsonPath": "$",
        "type": "CUSTOM",
        "enabled": true
      },
