{
  "schemaVersion": 1,
  "key": "intune-asset-import",
  "name": "Microsoft Intune Asset Import",
  "description": "Import Microsoft Intune managed devices into Jira Assets",
  "category": "Microsoft Intune",
  "flows": [
    "intune_managed_device_asset_import.json"
  ],
  "icon": "microsoft.svg",
  "author": "Rixter AB",
  "tags": [
    "microsoft",
    "intune",
    "assets",
    "devices",
    "mdm",
    "import"
  ],
  "createdAt": "2026-08-30",
  "credentialDefinitions": [
    {
      "key": "token-intune-asset-import-token",
      "name": "Intune Asset Import Token",
      "type": "TOKEN"
    },
    {
      "key": "oauth2-microsoft-intune",
      "name": "Microsoft Intune",
      "type": "OAUTH2",
      "data": {
        "config": {
          "url": {
            "authorizeUrl": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/authorize",
            "accessTokenUrl": "https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token"
          },
          "grantType": "client_credentials",
          "scope": "https://graph.microsoft.com/.default",
          "headerPrefix": "Bearer",
          "includeState": false,
          "includeScopeInAccessTokenReq": true,
          "sendParamsAs": "x-www-form-urlencoded",
          "urlEncode": false
        }
      }
    }
  ]
}
