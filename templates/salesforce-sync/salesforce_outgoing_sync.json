            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create Salesforce cases for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
