      "description": "Search for Jira issues using enhanced JQL search.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"jql\": \"project = {{_flow.SPACE}} AND \\\"cf[10153]\\\" ~ \\\"{{workItemId}}\\\" ORDER BY created DESC\",\n  \"maxResults\": 50,\n  \"fields\": [\n    \"summary\",\n    \"status\",\n    \"assignee\",\n    \"issuetype\"\n  ]\n}",
      "responseOpt": {
        "transformation": {
          "enabled": false,
          "script": "//JSM ASSET FILTER EXAMPLE\n// TAKES THE ASSET AQL RESPONSE\nconst input = context?.data;\n//FILTERS ON ATTRIBUTE IDs, EMPTY MEANS ALL ATTRIBUTES INCLUDED\nconst attributeIds = [];\n\nconst wanted = new Set((attributeIds || []).map(String));\nconst includeAll = wanted.size === 0;\n\nreturn {\n  // keep paging/meta fields\n  maxResults: input.maxResults,\n  startAt: input.startAt,\n  total: input.total,\n  isLast: input.isLast,\n  hasMoreResults: input.hasMoreResults,\n  last: input.last,\n\n  values: Array.isArray(input.values)\n    ? input.values.map((v) => {\n        const { avatar, objectType, attributes, ...rest } = v;\n\n        const slimAttributes = Array.isArray(attributes)\n          ? attributes\n              .filter((a) => includeAll || wanted.has(String(a.id)))\n              .map((a) => {\n                const { workspaceId, globalId, ...aRest } = a; // drop\n                return aRest;\n              })\n          : attributes;\n\n        return {\n          ...rest,\n          objectType: objectType ? { id: objectType.id, name: objectType.name } : objectType,\n          attributes: slimAttributes,\n        };\n      })\n    : input.values,\n};\n"
        }
      },
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/search/jql",
      "parentId": "",
      "flowVariables": [
        {
          "name": "issueKey",
          "behavior": "SET",
          "value": "$.response.data.issues[0].key",
          "instruction": ""
        }
      ],
      "name": "Check if issue exists",
      "id": "template:action:82c6f96b-6ff7-490a-8d05-ca4ecdf012dd",
      "order": 100
