      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"$schema\": \"https://api.atlassian.com/jsm/assets/imports/external/schema/versions/2023_10_19\",\n  \"schema\": {\n    \"objectSchema\": {\n      \"name\": \"{{_flow.assetSchema}}\",\n      \"description\": \"\",\n      \"objectTypes\": [\n        {\n          \"name\": \"Groups\",\n          \"description\": \"\",\n          \"attributes\": []\n        },\n        {\n          \"name\": \"Users\",\n          \"description\": \"\",\n          \"attributes\": [ \n            {\n               \"name\": \"groups\",\n              \"description\": \"\",\n              \"type\": \"referenced_object\",\n              \"label\": false,\n              \"unique\": false,\n              \"minimumCardinality\": 0,\n              \"maximumCardinality\": -1,\n              \"referenceObjectTypeName\": \"Groups\"\n            }\n          ]\n        }\n      ]\n    }\n  },\n  \"mapping\": {\n    \"objectTypeMappings\": [     \n      {\n        \"objectTypeName\": \"Users\",\n        \"selector\": \"value\",\n        \"description\": \"\",\n        \"attributesMapping\": [ \n          {\n            \"attributeName\": \"displayName\",\n            \"attributeLocators\": [\n              \"displayName\"\n            ]\n          },\n          {\n            \"attributeName\": \"groups\",\n            \"attributeLocators\": [\n              \"groupName\"\n            ],\n            \"objectMappingIQL\": \"displayName IN (${groupName})\" \n          }         \n        ]\n      }\n    ]\n  }\n}",
      "parentId": "",
      "enabled": true,
