          "script": "const input = response?.data?.value;\n\nreturn input?.map(({ id, displayName, ...item }) => ({\n  ...item,\n  groupId: id,\n  groupName: displayName,\n  displayName: scope?.displayName,\n  userId: scope?.id\n})) ?? [];"
        }
