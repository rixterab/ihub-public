          "grantType": "code",
          "scope": "offline_access User.Read User.Read.All Group.Read.All",
          "headerPrefix": "Bearer",
          "includeState": true,
          "includeScopeInAccessTokenReq": true,
          "sendParamsAs": "x-www-form-urlencoded",
          "urlEncode": false
        }
      }
    },
