  "description": "Sync Jira issues to GitHub issues",
  "enabled": false,
  "flowVariables": [
    {
      "name": "GITHUB_API_URL",
      "behavior": "SET",
      "value": "https://api.github.com",
      "instruction": "GitHub API URL. For GitHub Enterprise Server, replace with the enterprise API URL, for example https://github.example.com/api/v3."
    },
    {
      "name": "GITHUB_API_VERSION",
      "behavior": "SET",
      "value": "2026-03-10",
      "instruction": "GitHub REST API version sent in the X-GitHub-Api-Version header."
    },
    {
      "name": "GITHUB_OWNER",
      "behavior": "SET",
      "value": "your-org",
      "instruction": "GitHub repository owner or organization."
    },
    {
      "name": "GITHUB_REPO",
      "behavior": "SET",
      "value": "your-repo",
      "instruction": "GitHub repository name."
    }
  ],
