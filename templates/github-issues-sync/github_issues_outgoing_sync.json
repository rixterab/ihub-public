      "id": "template:action:03075045-d668-4f0b-8a9f-896d1befbc3a",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if a GitHub issue number exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create GitHub issues for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100,
      "description": "Creates a GitHub issue when Jira sends an issue-created event and no linked GitHub issue exists."
