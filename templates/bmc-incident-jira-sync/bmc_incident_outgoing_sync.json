          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "description": "Store the created BMC incident number on the Jira issue.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"fields\": {\n    \"customfield_10153\": \"{{_flow.incidentNumber}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}",
      "parentId": "template:action:a0de8afb-c205-44f7-8cf6-41e5f86f0834",
      "flowVariables": [],
      "name": "Store BMC Incident Number on Jira Issue",
      "id": "template:action:427d3d94-2c7b-436a-ba86-1f8afe8ae3d2",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only update the Jira issue after a create event"
            }
          ]
        }
      ],
      "order": 200
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
