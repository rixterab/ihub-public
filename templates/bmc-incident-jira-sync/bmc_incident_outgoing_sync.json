      "method": "PUT",
      "description": "Update the linked BMC incident when the Jira issue is updated.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-bmc-authorization"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"values\": {\n    \"Description\": \"{{{issue.fields.summary}}}\",\n    \"Detailed_Decription\": \"{{{adfToHTML issue.fields.description}}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.BMC_URL}}/api/arsys/v1/entry/{{_flow.BMC_INCIDENT_UPDATE_FORM}}/{{issue.fields.customfield_10153}}|{{issue.fields.customfield_10153}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "incidentNumber",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        }
      ],
      "name": "Update BMC Incident",
      "id": "template:action:0c76a7b8-bdc3-4d8d-abc7-6a702ee14217",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
