      "method": "POST",
      "description": "Create a BMC work log entry with the Jira attachment on the linked incident.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-bmc-authorization"
      },
      "logNoIterationItemsFound": false,
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"entry\": {\n    \"values\": {\n      \"Submitter\": \"{{_flow.BMC_WORK_LOG_SUBMITTER}}\",\n      \"Short Description\": \"Synced attachment from Jira issue {{issue.key}}\",\n      \"Description\": \"Synced attachment from Jira issue {{issue.key}}: {{filename}}\",\n      \"Detailed Description\": \"Synced attachment from Jira issue {{issue.key}}: {{filename}}\",\n      \"Work Log Submitter\": \"{{_flow.BMC_WORK_LOG_SUBMITTER}}\",\n      \"Incident Number\": \"{{issue.fields.customfield_10153}}\",\n      \"Work Log Type\": \"{{_flow.BMC_WORK_LOG_TYPE}}\",\n      \"View Access\": \"{{_flow.BMC_WORK_LOG_VIEW_ACCESS}}\",\n      \"{{_flow.BMC_WORK_LOG_ATTACHMENT_FIELD}}\": \"{{filename}}\"\n    },\n    \"mergeOptions\": {\n          \"ignorePatterns\": false,\n          \"ignoreRequired\": false,\n          \"workflowEnabled\": false,\n          \"associationsEnabled\": false,\n          \"mergeType\": \"DUP_NEW_ID\",\n          \"multimatchOption\": 1\n    },\n    \"qualification\": \"'Incident Number' = \\\"{{issue.fields.customfield_10153}}\\\"\"\n  },\n  \"attach-{{_flow.BMC_WORK_LOG_ATTACHMENT_FIELD}}\": \"{{attachments.unsentFile}}\"\n}",
      "logConditionsNotMet": false,
      "parentId": "",
      "enabled": true,
      "url": "{{_flow.BMC_URL}}/api/arsys/v1/mergeEntry/{{_flow.BMC_WORK_LOG_FORM}}?fields=values(Request%20ID)",
      "iterator": "$.payload.issue.fields.attachment",
      "flowVariables": [
        {
          "name": "attachmentWorkLogId",
          "behavior": "SET",
          "value": "$['response']['data']['values']['Request ID']",
          "instruction": ""
        }
      ],
      "name": "Upload Attachment to BMC Incident",
      "id": "template:action:6b52b2c9-8a89-41ee-a6fb-81d5005a6fbf",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS",
              "description": "Only upload attachments when the Jira issue has a BMC incident number"
            },
            {
              "jsonPath": "$.payload.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "Block attachments added by the iHub user"
            }
          ]
        }
      ],
      "order": 600,
      "contextLogAppender": "{{eventType}}"
    },
    {
      "headers": [
