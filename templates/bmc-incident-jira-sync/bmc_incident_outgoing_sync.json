      "name": "Store BMC Attachment ID",
      "description": "Store the BMC work log entry id on the Jira issue to prevent sync loops.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "id": "template:action:86521914-3309-4b9e-be83-9430d21aa271",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"externalId\": \"{{_flow.attachmentWorkLogId}}\",\n  \"status\": \"synced\",\n  \"source\": \"bmc\"\n}",
      "parentId": "template:action:6b52b2c9-8a89-41ee-a6fb-81d5005a6fbf",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}/properties/ihub-{{_flow.attachmentWorkLogId}}",
      "order": 700,
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$._flow.attachmentWorkLogId",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS",
              "description": "Only store the sync marker when BMC returns a work log entry id"
            }
          ]
        }
      ]
    }
