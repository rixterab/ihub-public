  "description": "Sync Jira issues to BMC Helix ITSM incidents",
  "enabled": false,
  "flowVariables": [
    {
      "name": "BMC_URL",
      "behavior": "SET",
      "value": "https://your-company-restapi.onbmc.com",
      "instruction": "BMC Helix ITSM / AR System REST API base URL, for example https://acme-restapi.onbmc.com or https://arserver.example.com:8008"
    },
    {
      "name": "BMC_INCIDENT_CREATE_FORM",
      "behavior": "SET",
      "value": "HPD:IncidentInterface_Create",
      "instruction": "BMC incident interface form used to create incidents"
    },
    {
      "name": "BMC_INCIDENT_UPDATE_FORM",
      "behavior": "SET",
      "value": "HPD:IncidentInterface",
      "instruction": "BMC incident interface form used to update incidents"
    },
    {
      "name": "BMC_WORK_LOG_FORM",
      "behavior": "SET",
      "value": "HPD:WorkLog",
      "instruction": "BMC work log form used for incident work information and attachments"
    },
    {
      "name": "BMC_WORK_LOG_ATTACHMENT_FIELD",
      "behavior": "SET",
      "value": "Attachment",
      "instruction": "Attachment field on the BMC work log form used for Jira attachment uploads"
    },
    {
      "name": "BMC_FIRST_NAME",
      "behavior": "SET",
      "value": "Allen",
      "instruction": "BMC requester first name used on incidents created from Jira"
    },
    {
      "name": "BMC_LAST_NAME",
      "behavior": "SET",
      "value": "Allbrook",
      "instruction": "BMC requester last name used on incidents created from Jira"
    },
    {
      "name": "BMC_COMPANY",
      "behavior": "SET",
      "value": "Calbro Services",
      "instruction": "BMC company value used on incidents created from Jira"
    },
    {
      "name": "BMC_IMPACT",
      "behavior": "SET",
      "value": "3-Moderate/Limited",
      "instruction": "BMC Impact value used on incidents created from Jira"
    },
    {
      "name": "BMC_URGENCY",
      "behavior": "SET",
      "value": "3-Medium",
      "instruction": "BMC Urgency value used on incidents created from Jira"
    },
    {
      "name": "BMC_CREATE_STATUS",
      "behavior": "SET",
      "value": "Assigned",
      "instruction": "BMC Status value used on incidents created from Jira"
    },
    {
      "name": "BMC_REPORTED_SOURCE",
      "behavior": "SET",
      "value": "Direct Input",
      "instruction": "BMC Reported Source value used on incidents created from Jira"
    },
    {
      "name": "BMC_SERVICE_TYPE",
      "behavior": "SET",
      "value": "User Service Restoration",
      "instruction": "BMC Service_Type value used on incidents created from Jira"
    },
    {
      "name": "BMC_WORK_LOG_SUBMITTER",
      "behavior": "SET",
      "value": "Allen",
      "instruction": "BMC submitter/login value used for work log entries created from Jira comments and attachments"
    },
    {
      "name": "BMC_WORK_LOG_TYPE",
      "behavior": "SET",
      "value": "General Information",
      "instruction": "BMC Work Log Type value used for synced Jira comments and attachments"
    },
    {
      "name": "BMC_WORK_LOG_VIEW_ACCESS",
      "behavior": "SET",
      "value": "Internal",
      "instruction": "BMC View Access value used for synced Jira comments and attachments"
    }
  ],
  "groupName": "BMC",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "BMC Incident Outgoing Sync",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
