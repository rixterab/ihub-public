      "method": "POST",
      "description": "Create a BMC Helix ITSM incident when a Jira issue without a linked BMC incident number is created.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-bmc-authorization"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"values\": {\n    \"First_Name\": \"{{_flow.BMC_FIRST_NAME}}\",\n    \"Last_Name\": \"{{_flow.BMC_LAST_NAME}}\",\n    \"Company\": \"{{_flow.BMC_COMPANY}}\",\n    \"Description\": \"{{{issue.fields.summary}}}\",\n    \"Detailed_Decription\": \"{{{adfToHTML issue.fields.description}}}\",\n    \"Impact\": \"{{_flow.BMC_IMPACT}}\",\n    \"Urgency\": \"{{_flow.BMC_URGENCY}}\",\n    \"Status\": \"{{_flow.BMC_CREATE_STATUS}}\",\n    \"Reported Source\": \"{{_flow.BMC_REPORTED_SOURCE}}\",\n    \"Service_Type\": \"{{_flow.BMC_SERVICE_TYPE}}\",\n    \"z1D_Action\": \"CREATE\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.BMC_URL}}/api/arsys/v1/entry/{{_flow.BMC_INCIDENT_CREATE_FORM}}?fields=values(Incident%20Number)",
      "parentId": "",
      "flowVariables": [
        {
          "name": "incidentNumber",
          "behavior": "SET",
          "value": "$['response']['data']['values']['Incident Number']",
          "instruction": ""
        },
        {
          "name": "incidentEntryUrl",
          "behavior": "SET",
          "value": "$['response']['data']['_links']['self'][0]['href']",
          "instruction": ""
        }
      ],
      "name": "Create BMC Incident",
      "id": "template:action:a0de8afb-c205-44f7-8cf6-41e5f86f0834",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if a BMC incident number already exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create BMC incidents for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
