      "method": "POST",
      "description": "Add the Jira comment to the linked BMC incident as a work log entry.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-bmc-authorization"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"values\": {\n    \"Submitter\": \"{{_flow.BMC_WORK_LOG_SUBMITTER}}\",\n    \"Short Description\": \"Synced from Jira issue {{issue.key}}\",\n    \"Description\": \"Synced from Jira issue {{issue.key}} (status: {{issue.fields.status.name}})\",\n    \"Detailed Description\": \"{{{adfToHTML payload.comment.body}}}\",\n    \"Work Log Submitter\": \"{{_flow.BMC_WORK_LOG_SUBMITTER}}\",\n    \"Incident Number\": \"{{issue.fields.customfield_10153}}\",\n    \"Work Log Type\": \"{{_flow.BMC_WORK_LOG_TYPE}}\",\n    \"View Access\": \"{{_flow.BMC_WORK_LOG_VIEW_ACCESS}}\"\n  },\n  \"mergeOptions\": {\n      \"ignorePatterns\": false,\n      \"ignoreRequired\": false,\n      \"workflowEnabled\": false,\n      \"associationsEnabled\": false,\n      \"mergeType\": \"DUP_NEW_ID\",\n      \"multimatchOption\": 1\n  },\n  \"qualification\": \"'Incident Number' = \\\"{{issue.fields.customfield_10153}}\\\"\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.BMC_URL}}/api/arsys/v1/mergeEntry/{{_flow.BMC_WORK_LOG_FORM}}?fields=values(Request%20ID)",
      "parentId": "",
      "flowVariables": [
        {
          "name": "incidentNumber",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        },
        {
          "name": "workLogEntryId",
          "behavior": "SET",
          "value": "$['response']['data']['values']['Request ID']",
          "instruction": ""
        }
      ],
      "name": "Comment BMC Incident",
      "id": "template:action:9729271c-218d-4b00-ac79-1381ec68570d",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:commented:issue",
              "operator": "EQUALS"
            },
            {
              "jsonPath": "$.comment.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "User shall not be iHub"
            }
          ]
        }
      ],
      "order": 300
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
