{
  "actions": [
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        }
      ],
      "method": "POST",
      "description": "Create a HubSpot ticket from a Jira work item.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:custom-header-hubspot-token"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"properties\": {\n    \"subject\": \"{{issue.key}} - {{issue.fields.summary}}\",\n    \"content\": \"Created from Jira: {{baseUrl}}/browse/{{issue.key}}\\n\\nPriority: {{#if issue.fields.priority.name}}{{issue.fields.priority.name}}{{else}}None{{/if}}\\nReporter: {{#if issue.fields.reporter.displayName}}{{issue.fields.reporter.displayName}}{{else}}Unknown{{/if}}\",\n    \"hs_pipeline\": \"{{_flow.HUBSPOT_PIPELINE_ID}}\",\n    \"hs_pipeline_stage\": \"{{_flow.HUBSPOT_STAGE_ID}}\"\n  }\n}",
      "enabled": true,
      "url": "https://api.hubapi.com/crm/v3/objects/tickets",
      "parentId": "",
      "flowVariables": [
        {
          "name": "hubspotTicketId",
          "behavior": "SET",
          "value": "$.response.data.id",
          "instruction": "ID of the created HubSpot ticket."
        }
      ],
      "name": "Create HubSpot Ticket",
      "id": "template:action:2566ae59-5180-4c23-982e-02233919e693",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS"
            },
            {
              "jsonPath": "$.issue.fields.project.key",
              "type": "DATA_CONDITION",
              "value": "{{_flow.SPACE}}",
              "operator": "EQUALS"
            }
          ]
        }
      ],
      "ratelimit": {
        "sleepTime": 1000,
        "initialSleepTime": 5000,
        "maxRetries": 1,
        "burst": 10,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "order": 100
    }
  ],
  "description": "Create a HubSpot ticket when a Jira work item is created",
  "enabled": false,
  "flowVariables": [
    {
      "name": "SPACE",
      "behavior": "SET",
      "value": "HUBSPOT",
      "instruction": "Jira project key to monitor."
    },
    {
      "name": "HUBSPOT_PIPELINE_ID",
      "behavior": "SET",
      "value": "0",
      "instruction": "HubSpot ticket pipeline ID."
    },
    {
      "name": "HUBSPOT_STAGE_ID",
      "behavior": "SET",
      "value": "1",
      "instruction": "HubSpot ticket stage ID."
    }
  ],
  "groupName": "HubSpot",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "HubSpot - Create Ticket from Jira",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
