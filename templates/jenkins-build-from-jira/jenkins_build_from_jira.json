{
  "actions": [
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "application/x-www-form-urlencoded",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "POST",
      "name": "Trigger Jenkins Job",
      "description": "Trigger a parameterised Jenkins job with Jira work item metadata.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:basic-auth-jenkins"
      },
      "id": "template:action:7f2b90c4-6e15-4a38-bd07-51ca9e836f20",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.JENKINS_URL}}/job/{{_flow.JENKINS_JOB}}/buildWithParameters?JIRA_ISSUE_KEY={{issue.key}}&JIRA_ISSUE_URL={{baseUrl}}/browse/{{issue.key}}&JIRA_ISSUE_TYPE={{issue.fields.issuetype.name}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "jenkinsQueueUrl",
          "behavior": "SET",
          "value": "$.response.headers.location",
          "instruction": "Jenkins queue item URL for the triggered build."
        }
      ],
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only run for Jira work item created events"
            },
            {
              "jsonPath": "$.issue.fields.project.key",
              "type": "DATA_CONDITION",
              "value": "{{_flow.SPACE}}",
              "operator": "EQUALS",
              "description": "Only run for the configured Jira project"
            },
            {
              "jsonPath": "$.issue.fields.issuetype.name",
              "type": "DATA_CONDITION",
              "value": "{{_flow.TRIGGER_ISSUE_TYPE}}",
              "operator": "EQUALS",
              "description": "Only trigger builds for the configured Jira issue type"
            }
          ]
        }
      ],
      "ratelimit": {
        "sleepTime": 1000,
        "initialSleepTime": 5000,
        "maxRetries": 1,
        "burst": 10,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "order": 100
    }
  ],
  "description": "Trigger a Jenkins job when a Jira work item is created",
  "enabled": false,
  "flowVariables": [
    {
      "name": "SPACE",
      "behavior": "SET",
      "value": "JENKINS",
      "instruction": "Jira project key to monitor."
    },
    {
      "name": "TRIGGER_ISSUE_TYPE",
      "behavior": "SET",
      "value": "Task",
      "instruction": "Jira issue type that should trigger a build."
    },
    {
      "name": "JENKINS_URL",
      "behavior": "SET",
      "value": "https://jenkins.example.com",
      "instruction": "Jenkins base URL, without a trailing slash."
    },
    {
      "name": "JENKINS_JOB",
      "behavior": "SET",
      "value": "my-job",
      "instruction": "Jenkins job name. For a job inside a folder use folder/job/name."
    }
  ],
  "groupName": "Jenkins",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "Jenkins - Trigger Job from Jira",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
