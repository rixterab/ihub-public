          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PATCH",
      "description": "Add the Jira comment to the linked ServiceNow ticket as an additional comment.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:oauth2-servicenow"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"comments\": \"Synced from Jira issue {{issue.key}} (status: {{issue.fields.status.name}})\\n{{{adfToHTML payload.comment.body}}}\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.SN_URL}}/api/now/{{_flow.SN_API_VERSION}}/table/{{_flow.SN_TABLE}}/{{issue.fields.customfield_10153}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "sysId",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        }
      ],
      "name": "Comment ServiceNow Ticket",
      "id": "template:action:9f13c5e8-4a70-4d29-b53e-8c1a6d2f0b97",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:commented:issue",
              "operator": "EQUALS"
            },
            {
              "jsonPath": "$.comment.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "User shall not be iHub"
            }
          ]
        }
      ],
      "order": 300
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "name": "Store Outgoing Comment ID",
      "description": "Mark the Jira comment as synced to ServiceNow to prevent sync loops.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "id": "template:action:6b47e0d3-1c58-49a2-8f61-3d9e7a5c4b02",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"externalId\": \"{{comment.id}}\",\n  \"status\": \"synced\",\n  \"source\": \"jira\"\n}",
      "parentId": "template:action:9f13c5e8-4a70-4d29-b53e-8c1a6d2f0b97",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}/properties/ihub-{{comment.id}}",
      "order": 400
    },
    {
      "ratelimit": {
        "sleepTime": 500,
        "initialSleepTime": 5000,
        "maxRetries": 0,
        "burst": 20,
        "retryStatusCodes": [
          408,
          429,
          500,
          502,
          503,
          504
        ]
      },
