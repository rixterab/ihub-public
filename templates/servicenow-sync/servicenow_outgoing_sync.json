          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "POST",
      "description": "Upload Jira attachments to the linked ServiceNow ticket using the Attachment API.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:oauth2-servicenow"
      },
      "logNoIterationItemsFound": false,
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"table_name\": \"{{_flow.SN_TABLE}}\",\n  \"table_sys_id\": \"{{issue.fields.customfield_10153}}\",\n  \"uploadFile\": \"{{attachments.unsentFile}}\"\n}",
      "logConditionsNotMet": false,
      "parentId": "",
      "enabled": true,
      "url": "{{_flow.SN_URL}}/api/now/attachment/upload",
      "iterator": "$.payload.issue.fields.attachment",
      "flowVariables": [
        {
          "name": "attachmentSysId",
          "behavior": "SET",
          "value": "$.response.data.result.sys_id",
          "instruction": ""
        }
      ],
      "name": "Upload Attachment to ServiceNow Ticket",
      "id": "template:action:e71b3f95-8d24-4c60-a1f8-05c9b7e2d463",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS",
              "description": "Only upload attachments when the Jira issue has a ServiceNow sys_id"
            },
            {
              "jsonPath": "$.payload.author.accountId",
              "type": "DATA_CONDITION",
              "value": "712020:6a00297e-29ca-4539-8eba-272c510f6e9d",
              "operator": "NOT_EQUALS",
              "description": "Block attachments added by the iHub user"
            }
          ]
        }
      ],
      "order": 600,
      "contextLogAppender": "{{eventType}}"
    },
