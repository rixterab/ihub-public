      "method": "POST",
      "description": "Create a ServiceNow ticket when a Jira issue without a linked sys_id is created.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:oauth2-servicenow"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"short_description\": \"{{{issue.fields.summary}}}\",\n  \"description\": \"{{{adfToHTML issue.fields.description}}}\",\n  \"contact_type\": \"{{_flow.SN_CONTACT_TYPE}}\",\n  \"impact\": \"{{_flow.SN_IMPACT}}\",\n  \"urgency\": \"{{_flow.SN_URGENCY}}\",\n  \"correlation_id\": \"{{issue.key}}\",\n  \"correlation_display\": \"Jira\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.SN_URL}}/api/now/{{_flow.SN_API_VERSION}}/table/{{_flow.SN_TABLE}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "sysId",
          "behavior": "SET",
          "value": "$.response.data.result.sys_id",
          "instruction": ""
        },
        {
          "name": "ticketNumber",
          "behavior": "SET",
          "value": "$.response.data.result.number",
          "instruction": ""
        }
      ],
      "name": "Create Ticket in ServiceNow",
      "id": "template:action:c58a1e74-0d92-4f36-8b17-6a2e9c4d3f81",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "EQUALS",
              "description": "Check if a ServiceNow sys_id already exists on the Jira issue"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only create ServiceNow tickets for Jira issue created events"
            }
          ]
        }
      ],
      "order": 100
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
        {
          "value": "IntegrationsHub/Cloud",
          "key": "User-Agent"
        },
        {
          "value": "no-cache",
          "key": "Cache-Control"
        }
      ],
      "method": "PUT",
      "description": "Store the created ServiceNow sys_id on the Jira issue.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"fields\": {\n    \"customfield_10153\": \"{{_flow.sysId}}\"\n  }\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}",
      "parentId": "template:action:c58a1e74-0d92-4f36-8b17-6a2e9c4d3f81",
      "flowVariables": [],
      "name": "Store ServiceNow sys_id on Jira Issue",
      "id": "template:action:2d94f6b1-7e35-48c0-9a6d-1b8f5c07e2a4",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:created:issue",
              "operator": "EQUALS",
              "description": "Only update the Jira issue after a create event"
            }
          ]
        }
      ],
      "order": 200
    },
    {
      "headers": [
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "application/json",
          "key": "Content-Type"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
          "key": "Accept-Encoding"
        },
