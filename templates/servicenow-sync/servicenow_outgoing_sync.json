      "method": "PATCH",
      "description": "Update the linked ServiceNow ticket when the Jira issue is updated.",
      "credentialsReference": {
        "type": "DATABASE_REF",
        "value": "template:oauth2-servicenow"
      },
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"short_description\": \"{{{issue.fields.summary}}}\",\n  \"description\": \"{{{adfToHTML issue.fields.description}}}\"\n}",
      "logConditionsNotMet": false,
      "enabled": true,
      "url": "{{_flow.SN_URL}}/api/now/{{_flow.SN_API_VERSION}}/table/{{_flow.SN_TABLE}}/{{issue.fields.customfield_10153}}",
      "parentId": "",
      "flowVariables": [
        {
          "name": "sysId",
          "behavior": "SET",
          "value": "$.issue.fields.customfield_10153",
          "instruction": ""
        }
      ],
      "name": "Update ServiceNow Ticket",
      "id": "template:action:4a80d2c6-5b19-43e7-9c02-7f6b1e8d5a39",
      "conditions": [
        {
          "type": "COMBINED_CONDITION",
          "conditions": [
            {
              "jsonPath": "$.issue.fields.customfield_10153",
              "type": "DATA_CONDITION",
              "value": "",
              "operator": "NOT_EQUALS"
            },
            {
              "jsonPath": "$.eventType",
              "type": "DATA_CONDITION",
              "value": "avi:jira:updated:issue",
              "operator": "EQUALS"
            }
          ]
        }
      ],
      "order": 500
    },
    {
      "headers": [
        {
          "value": "multipart/form-data",
          "key": "Content-Type"
        },
        {
          "value": "application/json",
          "key": "Accept"
        },
        {
          "value": "keep-alive",
          "key": "Connection"
        },
        {
          "value": "gzip, deflate, br",
