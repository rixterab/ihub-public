      ],
      "method": "PUT",
      "name": "Store ServiceNow Attachment ID",
      "description": "Store the ServiceNow attachment sys_id on the Jira issue to prevent sync loops.",
      "credentialsReference": {
        "type": "ATLASSIAN_TOKEN",
        "value": "ATLASSIAN_AUTH_TOKEN"
      },
      "id": "template:action:1c6d8b40-3f57-4a92-b8e3-9a2f5c704d18",
      "type": "WEB_REQUEST_ACTION_TYPE",
      "body": "{\n  \"externalId\": \"{{_flow.attachmentSysId}}\",\n  \"status\": \"synced\",\n  \"source\": \"servicenow\"\n}",
      "parentId": "template:action:e71b3f95-8d24-4c60-a1f8-05c9b7e2d463",
      "enabled": true,
      "url": "{{baseUrl}}/rest/api/3/issue/{{issue.key}}/properties/ihub-{{_flow.attachmentSysId}}",
      "order": 700
    }
  ],
  "description": "Sync Jira issues to ServiceNow tickets",
  "enabled": false,
  "flowVariables": [
    {
      "name": "SN_URL",
      "behavior": "SET",
      "value": "https://your-instance.service-now.com",
      "instruction": "ServiceNow instance URL, for example https://acme.service-now.com"
    },
    {
      "name": "SN_API_VERSION",
      "behavior": "SET",
      "value": "v2",
      "instruction": "ServiceNow Table API version used in /api/now/{version}/table"
    },
    {
      "name": "SN_TABLE",
      "behavior": "SET",
      "value": "incident",
      "instruction": "ServiceNow table holding the tickets, for example incident, sn_customerservice_case or sc_req_item"
    },
    {
      "name": "SN_CONTACT_TYPE",
      "behavior": "SET",
      "value": "integration",
      "instruction": "ServiceNow contact_type value set on tickets created from Jira"
    },
    {
      "name": "SN_IMPACT",
      "behavior": "SET",
      "value": "3",
      "instruction": "ServiceNow impact value (1 High, 2 Medium, 3 Low) used on created tickets"
    },
    {
      "name": "SN_URGENCY",
      "behavior": "SET",
      "value": "3",
      "instruction": "ServiceNow urgency value (1 High, 2 Medium, 3 Low) used on created tickets"
    }
  ],
  "groupName": "ServiceNow",
  "logLevel": "OFF",
  "logRetention": 3,
  "metadata": {
    "createdBy": "",
    "updatedBy": ""
  },
  "name": "ServiceNow Outgoing Sync",
  "trigger": {
    "type": "ATLASSIAN_WEBHOOK_TRIGGER_TYPE"
  },
  "useStaticIP": false
}
